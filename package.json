{
  "name": "securitycards-site",
  "type": "module",
  "version": "0.1.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cloudflare": "wrangler pages dev dist",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "sync:skill-catalog": "node scripts/sync-skill-catalog.mjs",
    "check:skill-catalog": "node scripts/sync-skill-catalog.mjs --check",
    "validate:skill": "node scripts/validate-skill.mjs && npm run check:skill-catalog",
    "lint:cards": "node scripts/lint-cards.mjs",
    "lint:cards:fix": "node scripts/lint-cards.mjs --fix",
    "lint:md": "markdownlint-cli2",
    "lint": "npm run lint:cards && npm run lint:md",
    "validate": "npm run lint && npm run check && npm test && npm run build && npm run verify:build && npm run validate:skill"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.2.4",
    "js-tiktoken": "^1.0.21",
    "posthog-js": "^1.418.10",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  }
}

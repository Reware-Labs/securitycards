# Analytics is disabled unless this flag is explicitly true.
PUBLIC_ANALYTICS_ENABLED=false

# Use a public PostHog project key (usually starts with "phc_").
PUBLIC_POSTHOG_KEY=

# Use the EU ingestion host shown by your PostHog project.
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Use "development" locally and "production" in deployment.
PUBLIC_ANALYTICS_ENVIRONMENT=development

---
/**
 * ThemeToggle — switches the whole site between light and dark. Rendered in
 * the SiteHeader's right-hand action cluster; sizing/shape come from the
 * shared `.theme-toggle` class in global.css.
 *
 * The actual theme is driven by a `data-theme` attribute on <html> (see the
 * dark overrides in global.css); this component just flips that attribute
 * and remembers the choice.
 *
 * The initial `data-theme` value is set by an inline, render-blocking script
 * in BaseLayout.astro's <head> (before this button ever paints), so the
 * correct icon shows immediately with no flash.
 */
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <!-- Sun (shown in dark mode — click to go light) -->
  <svg class="theme-toggle-icon theme-toggle-icon--sun" xmlns="http://www.w3.org/2000/svg"
       width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"
       stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>

  <!-- Moon (shown in light mode — click to go dark) -->
  <svg class="theme-toggle-icon theme-toggle-icon--moon" xmlns="http://www.w3.org/2000/svg"
       width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"
       stroke-width="2" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script src="../scripts/theme-toggle.ts"></script>

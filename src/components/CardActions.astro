---
/**
 * CardActions — Copy and Download buttons on the card detail page.
 *
 * The raw markdown is stored in data-content; the client script reads it.
 * Astro automatically HTML-escapes attribute values, so no XSS risk.
 */
interface Props {
  rawMarkdown: string;
  filename:    string;   // e.g. "injection.md"
}
const { rawMarkdown, filename } = Astro.props;
---

<div class="card-actions">
  <button
    class="icon-btn copy-btn"
    type="button"
    data-content={rawMarkdown}
    data-default-label="Copy raw markdown to clipboard"
    aria-label="Copy raw markdown to clipboard"
    title="Copy Markdown"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
    </svg>
    <span class="icon-btn-label">Copy</span>
  </button>

  <button
    class="icon-btn download-btn"
    type="button"
    data-content={rawMarkdown}
    data-filename={filename}
    aria-label={`Download ${filename}`}
    title={`Download ${filename}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
      <polyline points="7 10 12 15 17 10"/>
      <line x1="12" y1="15" x2="12" y2="3"/>
    </svg>
    <span class="icon-btn-label">Download</span>
  </button>

</div>

<script src="../scripts/card-actions.ts"></script>

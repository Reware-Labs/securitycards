---
/**
 * CommandPalette — ⌘K global search over every card.
 *
 * A native <dialog> (showModal gives us a free focus trap, Esc-to-close and a
 * ::backdrop). The input is an ARIA combobox; results are a listbox filled at
 * runtime by command-palette.ts, which lazy-fetches /search-index.json on first
 * open and scores it client-side. Rendered once per page by BaseLayout.
 */
---

<dialog class="cmdk" id="command-palette" aria-label="Search cards">
  <div class="cmdk-inner">
    <div class="cmdk-input-row">
      <svg class="cmdk-input-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
           fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <path stroke-linecap="round" d="M21 21l-4.35-4.35" />
      </svg>
      <input
        class="cmdk-input"
        id="cmdk-input"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
        aria-label="Search cards, categories and libraries"
        placeholder="Search cards, categories, libraries…"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="cmdk-esc">Esc</kbd>
    </div>

    <ul class="cmdk-list" id="cmdk-list" role="listbox" aria-label="Search results"></ul>

    <p class="cmdk-empty" id="cmdk-empty" hidden>No cards match your search.</p>
    <p class="cmdk-status" id="cmdk-status" role="status" aria-live="polite" hidden></p>

    <footer class="cmdk-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </footer>
  </div>
</dialog>

<script src="../scripts/command-palette.ts"></script>

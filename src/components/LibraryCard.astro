---
/**
 * LibraryCard — a single library tile on the home page.
 *
 * One tile per library/version group. The card is an <article> (not an <a>)
 * because it holds two separate interactive controls — the main "open this
 * library" link and a "download all cards" link. The main link is a
 * full-tile overlay (.library-card-link, position:absolute; inset:0) so the
 * whole card is still clickable; the download link sits above it (z-index)
 * so it remains independently clickable.
 */
import { getLanguageLabel } from '../utils/language';
import LibraryLogo from './LibraryLogo.astro';

interface Props {
  language:         string;
  library:          string;
  version:          string;
  count:            number;   // total individual security cards, across all categories
  tokenCount:       number;   // token estimate for the downloadable library bundle
  href:             string;   // e.g. "/libraries/python/flask/3-1-3/"
  keywords:         string;   // space-joined lowercased search terms
  categories:       string;   // space-joined category slugs
  downloadHref:     string | null;   // null if no combined download file exists
  downloadFilename: string;
}
const {
  language, library, version, count, tokenCount, href, keywords, categories,
  downloadHref, downloadFilename,
} = Astro.props;
---

<article
  class="library-card"
  data-library={library.toLowerCase()}
  data-language={language}
  data-keywords={keywords}
  data-categories={categories}
>
  <a class="library-card-link" href={href} aria-label={`View ${library} ${version} security cards`}
     data-analytics-event="library_opened" data-analytics-library={library}
     data-analytics-language={language} data-analytics-version={version}></a>

  <div class="library-card-topline">
    <LibraryLogo language={language} library={library} />
    <span class="badge badge--lang library-card-lang">{getLanguageLabel(language)}</span>
  </div>

  <div class="library-card-heading">
    <h2 class="library-card-title">{library}</h2>
    <span class="library-card-version">{version}</span>
    <span class="library-card-list-language">{getLanguageLabel(language)}</span>
  </div>

  <div class="library-card-footer">
    <p class="library-card-count">
      <span><span class="library-card-count-num">{count}</span> cards</span>
      <span class="library-card-tokens" title="Estimated with the GPT-4o tokenizer">~{tokenCount.toLocaleString('en-US')} tokens</span>
    </p>
    <div class="library-card-actions" aria-hidden={!downloadHref ? 'true' : undefined}>
      <span class="library-card-open" aria-hidden="true">Open <span>→</span></span>
      {downloadHref && (
        <a
          class="library-card-download"
          href={downloadHref}
          download={downloadFilename}
          aria-label={`Download all ${library} security cards, approximately ${tokenCount.toLocaleString('en-US')} tokens`}
          title="Download all cards"
          data-analytics-event="content_downloaded"
          data-analytics-library={library}
          data-analytics-language={language}
          data-analytics-version={version}
          data-analytics-content-type="library_bundle"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
               viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span class="sr-only">Download</span>
        </a>
      )}
    </div>
  </div>
</article>

---
import { Code } from 'astro:components';
import { normalizeShikiLang, shikiConfig } from '../utils/shiki';
import { formatTokenCount } from '../utils/tokens';

interface Props {
  title:       string;
  description?: string;
  lang:        'bash' | 'markdown' | 'text';
  code:        string;
  tokens?:     number;
  warn?:       boolean;
  copyLabel?:  string;
}
const { title, description, lang, code, tokens, warn = false, copyLabel } = Astro.props;

const clipboardIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
---

<div class="snippet-card">
  <div class="snippet-head">
    <div class="snippet-meta">
      <h3 class="snippet-title">{title}</h3>
      {description && <p class="snippet-desc">{description}</p>}
    </div>
    <div class="snippet-actions">
      {tokens !== undefined && (
        <span class={`snippet-tokens${warn ? ' snippet-tokens--warn' : ''}`} title="Estimated with the GPT-4o tokenizer">
          ≈ {formatTokenCount(tokens)} tokens
        </span>
      )}
      <button
        class="icon-btn copy-btn snippet-copy"
        type="button"
        data-content={code}
        data-default-label={copyLabel ?? `Copy ${title}`}
        aria-label={copyLabel ?? `Copy ${title}`}
        title="Copy"
        set:html={clipboardIcon}
      />
    </div>
  </div>
  <div class="snippet-body">
    <Code code={code} lang={normalizeShikiLang(lang)} themes={shikiConfig.themes} defaultColor={false} />
  </div>
</div>
